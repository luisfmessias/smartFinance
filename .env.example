# Segredo que assina o cookie de sessão (mínimo de 32 caracteres).
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Endereço público do app, usado nos links de redefinição de senha.
APP_URL=http://localhost:3000

# Conexões do Neon. A aplicação usa a string com pool (com -pooler no endereço).
DATABASE_URL=
# As migrações do Prisma usam a conexão direta (sem -pooler).
DATABASE_URL_UNPOOLED=
